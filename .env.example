# Copy to .env and replace every changeme before starting a pillar.
# ./lab.sh loads this file and always sets STARBASE_ROOT to the repo directory.

TZ=Europe/Prague
MY_DOMAIN=localhost
UI_PORT=8088

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

NEXTCLOUD_DB_PASSWORD=changeme
BOOKSTACK_DB_ROOT_PASSWORD=changeme
BOOKSTACK_DB_PASSWORD=changeme
NETBOX_DB_PASSWORD=changeme
NETBOX_SECRET_KEY=changeme-use-a-long-random-string
AUTHENTIK_POSTGRES_PASSWORD=changeme
AUTHENTIK_SECRET_KEY=changeme-use-a-long-random-string
STEPCA_INIT_PASSWORD=changeme
WOODPECKER_AGENT_SECRET=changeme-use-a-long-random-string
WOODPECKER_GITEA_SECRET=changeme-use-a-long-random-string
